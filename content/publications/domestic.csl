<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0.2" default-locale="ja" page-range-format="expanded" demote-non-dropping-particle="sort-only" punctuation-in-quote="true">
  <info>
    <title>ENLP BibTeX Style - Domestic Conference</title>
    <id>https://github.com/EhimeNLP/enlp-thesis-template-typ/enlp/enlp/domestic</id>
    <link href="https://github.com/EhimeNLP/enlp-thesis-template-typ/enlp/enlp" rel="self"/>
    <author>
      <name>Eito YONEYAMA</name>
    </author>
    <category citation-format="author-date"/>
    <category field="linguistics"/>
    <summary>Domestic-conference bibliography style based on the ENLP BibTeX CSL.</summary>
    <updated>2026-05-09T00:00:00+09:00</updated>
    <rights license="https://opensource.org/licenses/MIT">MIT License</rights>
  </info>

  <locale xml:lang="ja">
    <terms>
      <term name="and">and</term>
      <term name="et-al">et al.</term>
      <term name="page" form="short">
        <single>p.</single>
        <multiple>pp.</multiple>
      </term>
    </terms>
  </locale>

  <macro name="author-full-ja">
    <names variable="author" delimiter="，">
      <name form="long" initialize="false" delimiter="，"/>
      <substitute>
        <names variable="editor" delimiter="，">
          <name form="long" initialize="false" delimiter="，"/>
          <label form="short" prefix="（" suffix="）"/>
        </names>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="issued">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="volume-issue-pages">
    <group delimiter=", ">
      <group delimiter=" ">
        <text variable="volume" font-weight="bold"/>
        <text variable="issue" prefix="(" suffix=")"/>
      </group>
      <group delimiter=" ">
        <label variable="page" form="short" plural="always"/>
        <text variable="page"/>
      </group>
    </group>
  </macro>

  <citation et-al-min="3" et-al-use-first="1">
    <layout prefix="(" suffix=")" delimiter="; ">
      <text macro="author-full-ja"/>
      <text macro="issued"/>
    </layout>
  </citation>

  <bibliography et-al-min="100" et-al-use-first="100" hanging-indent="true" entry-spacing="0" line-spacing="1">
    <layout suffix=".">
      <group delimiter=". ">
        <group delimiter=". ">
          <text macro="author-full-ja"/>
          <text macro="issued"/>
        </group>
        <text variable="title"/>
        <group delimiter=", ">
          <text variable="container-title"/>
          <text macro="volume-issue-pages"/>
        </group>
        <text variable="note"/>
      </group>
    </layout>
  </bibliography>
</style>
